# weekly 环境变量示例
# 复制为根目录 .env 后按需修改；.env 已被 .gitignore 排除，绝不提交。
#
# ⚠️ 后端在启动时读取本文件（生产环境改由 systemd 的 EnvironmentFile 注入），
# 前端 Vite 也读取本文件来决定 /api 的代理目标。改端口只需改这一处，两端自动保持一致。

# 服务端口：后端监听端口，同时决定前端开发代理的转发目标
# 本地开发与线上（ECS）统一用 3701；前端 Vite 开发服务器固定 3700
PORT=3701

# 监听地址：不要改成 0.0.0.0，否则 Node 会直接暴露公网
HOST=127.0.0.1

# 数据库文件路径，相对路径以仓库根目录为基准
DB_PATH=data/weekly.db

# 运行环境：生产环境必须为 production
NODE_ENV=development

# 会话有效期（天），必须与 session 表 expires_at 保持一致
SESSION_DAYS=30

# ISO 周次上限，不可改
MAX_WEEK=53

# 时间轴起点年份，不可改
START_YEAR=2026

# 同 IP 每小时注册上限
REGISTER_LIMIT_PER_HOUR=10
