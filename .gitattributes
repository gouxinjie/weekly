# 版本库内统一使用 LF，避免 Windows 上提交的 CRLF 破坏 Linux 部署文件
* text=auto

# Shell 脚本必须为 LF，否则 Linux 上执行会报 "bash\r: No such file or directory"
*.sh text eol=lf

# systemd 单元与 Nginx 配置对行尾敏感，必须为 LF
*.service text eol=lf
*.conf text eol=lf

# 图片等二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
